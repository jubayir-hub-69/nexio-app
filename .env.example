# Copy to .env.local. Do not put PRIVATE_KEY in a NEXT_PUBLIC variable.
# PRIVATE_KEY stays in the gitignored .env file and is used only by Hardhat.

NEXT_PUBLIC_NETWORK=mainnet
NEXT_PUBLIC_ANS_ADDRESS=0xE3FdB021493953C95F4c93bCCF83B762e4475Ed7
NEXT_PUBLIC_DAILY_GM_ADDRESS=0x609A9D897DB4c554a03d4304c8EF42b56ea32e31
NEXT_PUBLIC_EURC_VAULT_ADDRESS=0xb30c9272a28749Ae0B04E1d5977337a570025009
NEXT_PUBLIC_USDC_VAULT_ADDRESS=0x045700Cd0D442E65dcB549330580d9981bcbC5E0
NEXT_PUBLIC_NEXIO_SWAP_ADDRESS=0xD3504e2118b1c7a52cf44947510633562635ee03

# Achswap Developer API. Swap quotes and transactions are proxied through /api/achswap.
# The proxy sends Authorization: Bearer <key>. Prefer ACHSWAP_API_KEY so the key stays on the server.
# NEXT_PUBLIC_ACHSWAP_API_KEY is used only when ACHSWAP_API_KEY is empty.
ACHSWAP_API_KEY=
NEXT_PUBLIC_ACHSWAP_API_KEY=
