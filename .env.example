# Copy to .env.local for Next.js runtime variables. Do not put PRIVATE_KEY in .env or any NEXT_PUBLIC_ variable.
# PRIVATE_KEY belongs exclusively in the gitignored .env.hardhat file so Next.js never loads it into web server memory.
# The app is locked to Arc Mainnet (chain ID 5042).

NEXT_PUBLIC_ANS_ADDRESS=0xE3FdB021493953C95F4c93bCCF83B762e4475Ed7
NEXT_PUBLIC_DAILY_GM_ADDRESS=0x1A85147a0b372A56A2C93515E44d99d062264c54
NEXT_PUBLIC_EURC_VAULT_ADDRESS=0xfE128bCc8F4D45AB9E24bF446EEa8302d1FD4CB7
NEXT_PUBLIC_USDC_VAULT_ADDRESS=0x77e46702C82f16D6227686e0ED8882c3cf44e599
NEXT_PUBLIC_NEXIO_SWAP_ADDRESS=0xD3504e2118b1c7a52cf44947510633562635ee03
NEXT_PUBLIC_ADDRESS_BOOK_ADDRESS=0xD043C8e124bBa0Eb33F5f62348f1914e425663C0

# Achswap Developer API. Quotes, the EURC/USD rate, and swap transactions
# are proxied through /api/achswap. The route reads this server-only variable.
# Do not copy the key into a NEXT_PUBLIC_ variable. Next.js would ship that to the browser.
ACHSWAP_API_KEY=
# Receives the Nexio partner fee on Achswap swaps. Defaults to the treasury below when unset.
ACHSWAP_FEE_RECIPIENT=0x9AFe5CeF11fC10756faef213f7A30D9873B5d372
